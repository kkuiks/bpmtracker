{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical musical timeline with separate notation hypotheses",
  "type": "object",
  "required": ["schema_version", "source", "clock", "quarter_events", "bar_events", "grid_support_seconds", "experimental", "automatic_accuracy_validated", "confidence_calibrated"],
  "properties": {
    "schema_version": {"const": 2},
    "source": {
      "type": "object",
      "required": ["sha256", "sample_rate", "sample_frames"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sample_rate": {"type": "integer", "minimum": 1},
        "sample_frames": {"type": "integer", "minimum": 1}
      }
    },
    "clock": {
      "type": "object",
      "required": ["knots", "meter_used"],
      "properties": {
        "meter_used": {"const": false},
        "knots": {
          "type": "array", "minItems": 2,
          "items": {"type": "object", "required": ["quarter", "seconds"], "properties": {"quarter": {"type": "number"}, "seconds": {"type": "number"}}}
        }
      }
    },
    "quarter_events": {"type": "array", "items": {"type": "object", "required": ["quarter", "seconds"]}},
    "bar_events": {
      "type": "array",
      "items": {
        "type": "object", "required": ["seconds", "quarter", "quarter_length", "signature", "alternatives", "notation_status"],
        "properties": {
          "seconds": {"type": "number", "minimum": 0},
          "quarter": {"type": "number"},
          "quarter_length": {"type": ["number", "null"]},
          "signature": {"type": ["object", "null"]},
          "alternatives": {"type": "array"},
          "notation_status": {"enum": ["proposed", "unresolved"]}
        }
      }
    },
    "grid_support_seconds": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}}},
    "experimental": {"type": "boolean"},
    "automatic_accuracy_validated": {"type": "boolean"},
    "confidence_calibrated": {"type": "boolean"}
  },
  "$comment": "Notation alternatives are hypotheses, not an adopted general-equivalence score. Validate monotonicity, source bounds and support/event consistency at runtime. Native Windows product validation remains separate."
}
